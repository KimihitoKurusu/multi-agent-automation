{
  "name": "multi-agent-automation",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-agent platform for governed web research, browser automation and human-in-the-loop workflows.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "format": "prettier --write --ignore-unknown --no-error-on-unmatched-pattern \"*.{json,yaml,yml,js,mjs,cjs,ts}\" \"{apps,packages,mcp,scripts,tests,quality}/**/*.{json,yaml,yml,js,mjs,cjs,ts}\"",
    "format:check": "prettier --check --ignore-unknown --no-error-on-unmatched-pattern \"*.{json,yaml,yml,js,mjs,cjs,ts}\" \"{apps,packages,mcp,scripts,tests,quality}/**/*.{json,yaml,yml,js,mjs,cjs,ts}\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "commitlint": "commitlint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:format": "pnpm format:check",
    "validate:lint": "pnpm lint",
    "validate:typecheck": "pnpm typecheck",
    "validate:test": "pnpm test",
    "validate": "pnpm validate:format && pnpm validate:lint && pnpm validate:typecheck && pnpm validate:test",
    "prepare": "husky",
    "branch:check": "tsx scripts/quality/check-branch.ts",
    "branch:check-push": "tsx scripts/quality/check-push-branches.ts",
    "governance:check": "tsx scripts/quality/check-protected-governance.ts",
    "clean": "node -e \"console.log('Nothing to clean yet')\""
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24",
    "eslint": "10.13.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.0",
    "prettier": "3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^5.9",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,mts,cts}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,yaml,yml}": [
      "prettier --write"
    ]
  }
}
